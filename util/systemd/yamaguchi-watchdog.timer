[Unit]
Description=Daily Duplicati server-run backup watchdog (Yamaguchi job)
Documentation=file:///home/pcalnon/Development/python/Juniper/juniper-ml/util/ad-hoc/yamaguchi_watchdog.py

[Timer]
# The job fires daily at 13:00Z (07:00 CST, 08:00 CDT) since the owner moved it on
# 2026-11-15; 14:00Z before. Scheduled runs have taken up to 6h53m. The check moved
# from 12:00 to 20:00 local the same day: a run still in progress reads OK/RUNNING,
# which judges no result and, by the owner's ruling of 2026-11-15, does not count
# toward the design's AC-5 -- and at 12:00 most runs were still in progress. A run
# still going at 20:00 is past --max-run-hours (6 h) and reads ALERT STUCK; "stale"
# (26 h) still covers a run that was skipped entirely.
OnCalendar=*-*-* 20:00:00
# A workstation is often off at the check time. Without this a missed check is
# silently skipped -- the failure mode the watchdog exists to prevent.
Persistent=true
Unit=yamaguchi-watchdog.service

[Install]
WantedBy=timers.target
